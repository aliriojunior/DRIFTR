<Window x:Class="PokeQuad.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DRIFTR — Sign in" Width="470" Height="590" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" Icon="{StaticResource DriftrWindowIcon}">
    <Grid Margin="38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="DRIFTR" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
            <TextBlock Text="ONE WINDOW. EVERY WORLD." Margin="1,2,0,0" FontSize="10"
                       FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="7" Padding="26">
            <StackPanel>
                <TextBlock x:Name="HeadingLabel" Text="Welcome back" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="SubheadingLabel" Text="Sign in to continue to DRIFTR." Margin="0,5,0,24"
                           Foreground="{StaticResource MutedTextBrush}" />

                <TextBlock Text="EMAIL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                <TextBox x:Name="EmailBox" AutomationProperties.AutomationId="EmailBox" Margin="0,6,0,16" Height="38"
                         Padding="9,7" Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}" CaretBrush="{StaticResource TextBrush}" />

                <TextBlock Text="PASSWORD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                <PasswordBox x:Name="PasswordBox" AutomationProperties.AutomationId="PasswordBox" Margin="0,6,0,16" Height="38"
                             Padding="9,7" Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}" CaretBrush="{StaticResource TextBrush}" />

                <StackPanel x:Name="ConfirmPasswordPanel" Visibility="Collapsed">
                    <TextBlock Text="CONFIRM PASSWORD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                    <PasswordBox x:Name="ConfirmPasswordBox" AutomationProperties.AutomationId="ConfirmPasswordBox" Margin="0,6,0,16" Height="38"
                                 Padding="9,7" Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" CaretBrush="{StaticResource TextBrush}" />
                </StackPanel>

                <TextBlock x:Name="ErrorLabel" AutomationProperties.AutomationId="AuthError" TextWrapping="Wrap"
                           Foreground="#E16974" MinHeight="20" Margin="0,0,0,10" />
                <Button x:Name="SubmitButton" AutomationProperties.AutomationId="SubmitAuth" Content="SIGN IN" Height="42"
                        Background="{StaticResource BrandBrush}" FontWeight="Bold" Click="SubmitButton_Click" />
                <Button x:Name="SwitchModeButton" AutomationProperties.AutomationId="SwitchAuthMode" Content="CREATE AN ACCOUNT"
                        Margin="2,10,2,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}"
                        Click="SwitchModeButton_Click" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Text="A network connection is required to validate your license."
                   HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
    </Grid>
</Window>
