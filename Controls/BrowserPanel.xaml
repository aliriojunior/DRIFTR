<UserControl x:Class="PokeQuad.Controls.BrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="Transparent"
             Focusable="True">
    <Border x:Name="PanelBorder"
            Margin="2"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="3"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="AccentStrip" Grid.Column="0" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="FullToolbar" Grid.Row="0" Height="36" Margin="7,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="112" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AccountLabel" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="100" />
                        <Button Content="&#x270E;" Padding="5,2" Margin="4,0,0,0" ToolTip="Rename account" automation:AutomationProperties.Name="Rename account" Click="RenameButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,0,0">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,5,0" />
                        <TextBlock x:Name="StatusLabel" Text="LOADING" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Content="&#x2190;" Padding="7,3" ToolTip="Back" automation:AutomationProperties.Name="Back" Click="BackButton_Click" IsEnabled="False" />
                        <Button x:Name="ForwardButton" Content="&#x2192;" Padding="7,3" ToolTip="Forward" automation:AutomationProperties.Name="Forward" Click="ForwardButton_Click" IsEnabled="False" />
                        <Button Content="&#x21BB;" Padding="7,3" ToolTip="Refresh" automation:AutomationProperties.Name="Refresh" Click="RefreshButton_Click" />
                        <Button Content="&#x2302;" Padding="7,3" ToolTip="Home" automation:AutomationProperties.Name="Home" Click="HomeButton_Click" />
                        <Button Content="&#x2212;" Padding="7,3" ToolTip="Zoom out" automation:AutomationProperties.Name="Zoom out" Click="ZoomOutButton_Click" />
                        <TextBlock x:Name="ZoomLabel" Width="39" Text="100%" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Content="+" Padding="7,3" ToolTip="Zoom in" automation:AutomationProperties.Name="Zoom in" Click="ZoomInButton_Click" />
                        <Button x:Name="AccentButton" Content="&#x25CF;" Padding="7,3" ToolTip="Change account accent" automation:AutomationProperties.Name="Change account accent" Click="AccentButton_Click" />
                        <Button x:Name="PopOutButton" Content="POP OUT" Padding="7,3" ToolTip="Move this account to its own window" automation:AutomationProperties.Name="Pop Out" Click="PopOutButton_Click" />
                        <Button x:Name="MaximizeButton" Content="&#x26F6;" Padding="8,3" ToolTip="Maximize or restore account" automation:AutomationProperties.Name="Maximize or restore account" Click="MaximizeButton_Click" />
                        <Button x:Name="OptionsButton" Content="&#x22EF;" Padding="7,3" ToolTip="Session options" automation:AutomationProperties.Name="Session options" Click="OptionsButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu><MenuItem Header="REPAIR SESSION" Click="RepairSessionMenuItem_Click"/></ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="MinimalToolbar" Grid.Row="0" Height="24" Margin="6,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="MinimalAccountLabel" Foreground="{StaticResource TextBrush}" FontSize="9" FontWeight="SemiBold" />
                        <Ellipse x:Name="MinimalStatusDot" Width="5" Height="5" Margin="7,0,4,0" />
                        <TextBlock x:Name="MinimalStatusLabel" Text="LOADING" Foreground="{StaticResource MutedTextBrush}" FontSize="8" FontWeight="Bold" />
                    </StackPanel>
                    <Button x:Name="MinimalPopOutButton" Grid.Column="1" Content="POP OUT" Padding="6,1" FontSize="8" ToolTip="Move this account to its own window" automation:AutomationProperties.Name="Pop Out" Click="PopOutButton_Click" />
                    <Button x:Name="MinimalOptionsButton" Grid.Column="2" Content="&#x22EF;" Padding="6,1" FontSize="8" ToolTip="Session options" automation:AutomationProperties.Name="Session options" Click="OptionsButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu><MenuItem Header="REPAIR SESSION" Click="RepairSessionMenuItem_Click"/></ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#090C11" />
                    <Border x:Name="StatusOverlay" Background="#EE11151D" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <TextBlock x:Name="StatusTitle" Text="Starting browser..." Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="StatusMessage" Text="Preparing an independent account profile" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480" Margin="0,7,0,0" />
                            <Button x:Name="RetryButton" Content="Retry" HorizontalAlignment="Center" Margin="0,13,0,0" Visibility="Collapsed" Click="RetryButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
