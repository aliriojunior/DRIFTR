<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <AssemblyName>DRIFTR</AssemblyName>
    <RootNamespace>PokeQuad</RootNamespace>
    <Product>DRIFTR</Product>
    <Company></Company>
    <Copyright></Copyright>
    <Description>Multi-session desktop browser.</Description>
    <Version>1.1.0-rc.5</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <ApplicationIcon>Assets\driftr.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\driftr.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="Diagnostics\RuntimeProbe\**\*.cs" />
    <None Remove="Tests\**\*" />
  </ItemGroup>
</Project>
