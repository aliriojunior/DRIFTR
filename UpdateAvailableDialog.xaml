<Window x:Class="PokeQuad.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available" Width="440" Height="270" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="{StaticResource DriftrWindowIcon}">
    <Border Margin="1" Padding="28" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="UPDATE AVAILABLE" Foreground="{StaticResource BrandBrush}" FontSize="18" FontWeight="Bold"/>
            <StackPanel Grid.Row="1" Margin="0,22,0,20">
                <TextBlock x:Name="AvailableVersionText" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Your current version:" Margin="0,18,0,3" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock x:Name="CurrentVersionText" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="LATER" MinWidth="84" Click="Later_Click"/>
                <Button Content="VIEW UPDATE" MinWidth="112" Margin="8,0,0,0" Background="{StaticResource BrandBrush}" Click="ViewUpdate_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
